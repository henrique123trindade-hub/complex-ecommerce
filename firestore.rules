rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'henrique123trindade@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation blueprints
    function isValidProduct(data) {
      return data.keys().hasAll([
        'id', 'slug', 'name', 'category', 'collection', 'priceBrl',
        'description', 'isNew', 'isFeatured', 'isDemo', 'active',
        'images', 'colors', 'sizes', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'slug', 'name', 'category', 'collection', 'priceBrl',
        'description', 'composition', 'careInstructions', 'fitNotes',
        'isNew', 'isFeatured', 'isDemo', 'active',
        'images', 'colors', 'sizes', 'measurements', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 128 && data.slug.matches('^[a-z0-9-]+$')
      && data.name is string && data.name.size() >= 2 && data.name.size() <= 140
      && data.category in ['Tees', 'Hoodies', 'Bottoms', 'Outerwear', 'Accessories']
      && data.collection is string && data.collection.size() >= 1 && data.collection.size() <= 80
      && data.priceBrl is number && data.priceBrl > 0 && data.priceBrl <= 100000
      && data.description is string && data.description.size() <= 2000
      && (!('composition' in data) || (data.composition is string && data.composition.size() <= 400))
      && (!('careInstructions' in data) || (data.careInstructions is string && data.careInstructions.size() <= 400))
      && (!('fitNotes' in data) || (data.fitNotes is string && data.fitNotes.size() <= 400))
      && data.isNew is bool
      && data.isFeatured is bool
      && data.isDemo is bool
      && data.active is bool
      && data.images is list && data.images.size() >= 1 && data.images.size() <= 12 && data.images[0] is string
      && data.colors is list && data.colors.size() >= 1 && data.colors.size() <= 10 && data.colors[0] is map
      && data.sizes is list && data.sizes.size() >= 1 && data.sizes.size() <= 10 && data.sizes[0] is map
      && (!('measurements' in data) || data.measurements is map)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['id', 'name', 'slug', 'image', 'orderIndex', 'updatedAt'])
      && data.keys().hasOnly(['id', 'name', 'slug', 'description', 'image', 'orderIndex', 'updatedAt'])
      && isValidId(data.id)
      && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
      && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 64 && data.slug.matches('^[a-z0-9-]+$')
      && (!('description' in data) || (data.description is string && data.description.size() <= 300))
      && data.image is string && data.image.size() >= 1 && data.image.size() <= 500
      && data.orderIndex is int && data.orderIndex >= 0 && data.orderIndex <= 100
      && data.updatedAt is timestamp;
    }

    function isValidEditorial(data) {
      return data.keys().hasAll([
        'id', 'heroTitle', 'heroSubtitle', 'heroCta',
        'campaignTitle', 'campaignCopy', 'storyTitle', 'storyCopy', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'announcementText', 'heroTitle', 'heroSubtitle', 'heroCta',
        'heroDesktopImage', 'heroMobileImage', 'brandKicker', 'brandTitle', 'brandCopy',
        'campaignTitle', 'campaignCopy', 'campaignCta', 'campaignImage',
        'storyKicker', 'storyTitle', 'storyCopy', 'storyImage', 'storyDetailImage',
        'contactEmail', 'instagramHandle', 'shippingNote', 'returnsNote', 'updatedAt'
      ])
      && isValidId(data.id)
      && (!('announcementText' in data) || (data.announcementText is string && data.announcementText.size() <= 140))
      && data.heroTitle is string && data.heroTitle.size() <= 80
      && data.heroSubtitle is string && data.heroSubtitle.size() <= 100
      && data.heroCta is string && data.heroCta.size() <= 60
      && (!('heroDesktopImage' in data) || (data.heroDesktopImage is string && data.heroDesktopImage.size() <= 500))
      && (!('heroMobileImage' in data) || (data.heroMobileImage is string && data.heroMobileImage.size() <= 500))
      && (!('brandKicker' in data) || (data.brandKicker is string && data.brandKicker.size() <= 80))
      && (!('brandTitle' in data) || (data.brandTitle is string && data.brandTitle.size() <= 140))
      && (!('brandCopy' in data) || (data.brandCopy is string && data.brandCopy.size() <= 400))
      && data.campaignTitle is string && data.campaignTitle.size() <= 80
      && data.campaignCopy is string && data.campaignCopy.size() <= 300
      && (!('campaignCta' in data) || (data.campaignCta is string && data.campaignCta.size() <= 60))
      && (!('campaignImage' in data) || (data.campaignImage is string && data.campaignImage.size() <= 500))
      && (!('storyKicker' in data) || (data.storyKicker is string && data.storyKicker.size() <= 80))
      && data.storyTitle is string && data.storyTitle.size() <= 120
      && data.storyCopy is string && data.storyCopy.size() <= 600
      && (!('storyImage' in data) || (data.storyImage is string && data.storyImage.size() <= 500))
      && (!('storyDetailImage' in data) || (data.storyDetailImage is string && data.storyDetailImage.size() <= 500))
      && (!('contactEmail' in data) || (data.contactEmail is string && data.contactEmail.size() <= 140))
      && (!('instagramHandle' in data) || (data.instagramHandle is string && data.instagramHandle.size() <= 80))
      && (!('shippingNote' in data) || (data.shippingNote is string && data.shippingNote.size() <= 300))
      && (!('returnsNote' in data) || (data.returnsNote is string && data.returnsNote.size() <= 300))
      && data.updatedAt is timestamp;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
      && data.keys().hasOnly(['uid', 'displayName', 'email', 'cpf', 'phone', 'status', 'lastLoginAt', 'createdAt', 'updatedAt'])
      && data.uid == userId
      && isValidId(data.uid)
      && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
      && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
      && (!('cpf' in data) || (data.cpf is string && data.cpf.size() <= 20))
      && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
      && (!('status' in data) || data.status in ['active', 'inactive'])
      && (!('lastLoginAt' in data) || data.lastLoginAt is timestamp)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidAddress(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'recipientName', 'cep', 'street', 'number', 'neighborhood', 'city', 'state', 'isDefault', 'createdAt'])
      && data.keys().hasOnly(['id', 'userId', 'label', 'recipientName', 'cep', 'street', 'number', 'complement', 'neighborhood', 'city', 'state', 'isDefault', 'createdAt'])
      && isValidId(data.id)
      && data.userId == userId
      && (!('label' in data) || (data.label is string && data.label.size() <= 60))
      && data.recipientName is string && data.recipientName.size() >= 2 && data.recipientName.size() <= 120
      && data.cep is string && data.cep.size() >= 8 && data.cep.size() <= 12
      && data.street is string && data.street.size() >= 2 && data.street.size() <= 160
      && data.number is string && data.number.size() >= 1 && data.number.size() <= 20
      && (!('complement' in data) || (data.complement is string && data.complement.size() <= 80))
      && data.neighborhood is string && data.neighborhood.size() >= 1 && data.neighborhood.size() <= 100
      && data.city is string && data.city.size() >= 2 && data.city.size() <= 100
      && data.state is string && data.state.size() == 2
      && data.isDefault is bool
      && data.createdAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
        'id', 'orderNumber', 'userId', 'customerName', 'customerEmail',
        'shippingAddress', 'shippingMethod', 'shippingCostBrl',
        'paymentMethod', 'discountBrl', 'subtotalBrl', 'totalBrl',
        'status', 'isDemo', 'items', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'orderNumber', 'userId', 'customerName', 'customerEmail', 'customerCpf',
        'shippingAddress', 'shippingMethod', 'shippingCostBrl',
        'paymentMethod', 'couponCode', 'discountBrl', 'subtotalBrl', 'totalBrl',
        'status', 'isDemo', 'items', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && data.orderNumber is string && data.orderNumber.size() >= 3 && data.orderNumber.size() <= 32
      && isValidId(data.userId)
      && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 120
      && data.customerEmail is string && data.customerEmail.size() >= 3 && data.customerEmail.size() <= 160
      && (!('customerCpf' in data) || (data.customerCpf is string && data.customerCpf.size() <= 20))
      && data.shippingAddress is map
      && data.shippingMethod is string && data.shippingMethod.size() >= 2 && data.shippingMethod.size() <= 80
      && data.shippingCostBrl is number && data.shippingCostBrl >= 0 && data.shippingCostBrl <= 5000
      && data.paymentMethod in ['pix', 'cartao']
      && (!('couponCode' in data) || (data.couponCode is string && data.couponCode.size() <= 40))
      && data.discountBrl is number && data.discountBrl >= 0 && data.discountBrl <= 50000
      && data.subtotalBrl is number && data.subtotalBrl > 0 && data.subtotalBrl <= 500000
      && data.totalBrl is number && data.totalBrl >= 0 && data.totalBrl <= 500000
      && data.status in ['demo_pending', 'confirmed', 'preparing', 'shipped', 'delivered', 'cancelled']
      && data.isDemo is bool
      && data.items is list && data.items.size() >= 1 && data.items.size() <= 50 && data.items[0] is map
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidCoupon(data) {
      return data.keys().hasAll(['code', 'discountPercent', 'minOrderBrl', 'active', 'usageCount', 'updatedAt'])
      && data.keys().hasOnly(['code', 'discountPercent', 'minOrderBrl', 'active', 'usageCount', 'updatedAt'])
      && data.code is string && data.code.size() >= 2 && data.code.size() <= 32 && data.code.matches('^[A-Z0-9_\\-]+$')
      && data.discountPercent is number && data.discountPercent > 0 && data.discountPercent <= 90
      && data.minOrderBrl is number && data.minOrderBrl >= 0 && data.minOrderBrl <= 100000
      && data.active is bool
      && data.usageCount is int && data.usageCount >= 0 && data.usageCount <= 1000000
      && data.updatedAt is timestamp;
    }

    function isValidNewsletter(data) {
      return data.keys().hasAll(['id', 'email', 'consent', 'createdAt'])
      && data.keys().hasOnly(['id', 'email', 'consent', 'createdAt'])
      && isValidId(data.id)
      && data.email is string && data.email.size() >= 5 && data.email.size() <= 160
      && data.consent == true
      && data.createdAt is timestamp;
    }

    // Health check document
    match /test/connection {
      allow get: if true;
    }

    // Admins registry
    match /admins/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isAdmin());
    }

    // Storefront catalog
    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create: if isValidId(productId) && isAdmin() && isValidProduct(incoming())
        && incoming().id == productId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(productId) && isAdmin() && isValidProduct(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(productId) && isAdmin();
    }

    // Categories
    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create: if isValidId(categoryId) && isAdmin() && isValidCategory(incoming())
        && incoming().id == categoryId
        && incoming().updatedAt == request.time;
      allow update: if isValidId(categoryId) && isAdmin() && isValidCategory(incoming())
        && incoming().id == existing().id
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    // Homepage & store editorial content
    match /editorial/{sectionId} {
      allow get: if isValidId(sectionId);
      allow list: if true;
      allow create: if isValidId(sectionId) && isAdmin() && isValidEditorial(incoming())
        && incoming().id == sectionId
        && incoming().updatedAt == request.time;
      allow update: if isValidId(sectionId) && isAdmin() && isValidEditorial(incoming())
        && incoming().id == existing().id
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(sectionId) && isAdmin();
    }

    // Customer profiles (PII isolated)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isVerified()
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (!('lastLoginAt' in incoming()) || incoming().lastLoginAt == request.time)
        && (
          (isOwner(userId) && (!('status' in incoming()) || incoming().status == 'active')) ||
          isAdmin()
        );
      allow update: if isValidId(userId) && isVerified()
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isOwner(userId)
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'cpf', 'phone', 'lastLoginAt', 'updatedAt'])
            && (!('lastLoginAt' in incoming()) || incoming().lastLoginAt == request.time || ('lastLoginAt' in existing() && incoming().lastLoginAt == existing().lastLoginAt))
          ) ||
          (
            isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'cpf', 'phone', 'status', 'updatedAt'])
          )
        );

      // Saved shipping addresses
      match /addresses/{addressId} {
        allow get: if isValidId(userId) && isValidId(addressId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow create: if isValidId(userId) && isValidId(addressId) && isVerified() && isOwner(userId)
          && isValidAddress(incoming(), userId)
          && incoming().id == addressId
          && incoming().createdAt == request.time;
        allow update: if isValidId(userId) && isValidId(addressId) && isVerified() && isOwner(userId)
          && isValidAddress(incoming(), userId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt;
        allow delete: if isValidId(userId) && isValidId(addressId) && (isOwner(userId) || isAdmin());
      }
    }

    // Orders (PII isolated)
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(orderId) && isVerified()
        && isValidOrder(incoming())
        && incoming().id == orderId
        && incoming().userId == request.auth.uid
        && incoming().status == 'demo_pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(orderId) && isAdmin()
        && isValidOrder(incoming())
        && existing().status != 'cancelled'
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // Coupons
    match /coupons/{couponId} {
      allow get: if isValidId(couponId);
      allow list: if isAdmin();
      allow create: if isValidId(couponId) && isAdmin() && isValidCoupon(incoming())
        && incoming().code == couponId
        && incoming().updatedAt == request.time;
      allow update: if isValidId(couponId) && isAdmin() && isValidCoupon(incoming())
        && incoming().code == existing().code
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(couponId) && isAdmin();
    }

    // Newsletter signups
    match /newsletter/{subscriberId} {
      allow create: if isValidId(subscriberId)
        && isValidNewsletter(incoming())
        && incoming().id == subscriberId
        && incoming().createdAt == request.time;
      allow get, list, update, delete: if isAdmin();
    }
  }
}
